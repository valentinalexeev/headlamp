# {{ ansible_managed }}
# Read by systemd (EnvironmentFile); mode 0600 root:root. Holds the API token.
AGENT_TOKEN={{ ingress_agent_token }}
AGENT_STATE_DIR={{ ingress_agent_state_dir }}
XRAY_BASE_CONFIG={{ xray_base_config }}
XRAY_CONFIG={{ xray_config }}
XRAY_BIN={{ xray_bin }}
XRAY_UNIT={{ xray_unit }}
XRAY_API={{ xray_api }}
XRAY_LOCATION_ASSET={{ xray_asset_dir }}
INGRESS_DIRECT_GEOIP={{ ingress_direct_geoip | join(',') }}
INGRESS_DIRECT_GEOSITE={{ ingress_direct_geosite | join(',') }}
INGRESS_EXIT_DNS={{ ingress_exit_dns | join(',') }}
INGRESS_EGRESS_SOCKS={{ ingress_egress_socks }}
INGRESS_EGRESS_URL={{ ingress_egress_url }}
{% if ingress_pathcheck_target | default('') | length > 0 %}
# Edge-to-central path check (GET /v1/pathcheck).
INGRESS_PATHCHECK_TARGET={{ ingress_pathcheck_target }}
INGRESS_PATHCHECK_ADDRS={{ ingress_pathcheck_addrs | join(',') }}
INGRESS_PATHCHECK_HEALTH_PATH={{ ingress_pathcheck_health_path }}
INGRESS_PATHCHECK_DERP_PATH={{ ingress_pathcheck_derp_path }}
INGRESS_PATHCHECK_STUN={{ ingress_pathcheck_stun }}
INGRESS_PATHCHECK_BLOB_URL={{ ingress_pathcheck_blob_url }}
INGRESS_PATHCHECK_BLOB_BYTES={{ ingress_pathcheck_blob_bytes }}
INGRESS_PATHCHECK_REF_URL={{ ingress_pathcheck_ref_url }}
INGRESS_PATHCHECK_INTERVAL={{ ingress_pathcheck_interval }}
INGRESS_PATHCHECK_BLOB_EVERY={{ ingress_pathcheck_blob_every }}
INGRESS_PATHCHECK_DAILY_BYTES={{ ingress_pathcheck_daily_bytes }}
INGRESS_PATHCHECK_TAILSCALE={{ ingress_pathcheck_tailscale }}
{% endif %}
{% if ingress_name | length > 0 and ingress_host | length > 0 and reality_public_key | length > 0 and reality_short_id | length > 0 %}
# Public parameters for GET /v1/info (no secrets).
INGRESS_NAME={{ ingress_name }}
INGRESS_HOST={{ ingress_host }}
INGRESS_PORT={{ ingress_listen_port }}
INGRESS_SNI={{ reality_sni }}
INGRESS_PUBLIC_KEY={{ reality_public_key }}
INGRESS_SHORT_ID={{ reality_short_id }}
{% if hy2_enabled | default(false) | bool %}
INGRESS_HY2_PORT={{ hy2_listen_port }}
{% endif %}
{% endif %}
