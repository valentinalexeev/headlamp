# {{ ansible_managed }}
# Read by systemd (EnvironmentFile); mode 0600 root:root. Holds the API token.
AGENT_TOKEN={{ ingress_agent_token }}
AGENT_STATE_DIR={{ ingress_agent_state_dir }}
XRAY_BASE_CONFIG={{ xray_base_config }}
XRAY_CONFIG={{ xray_config }}
XRAY_BIN={{ xray_bin }}
XRAY_UNIT={{ xray_unit }}
XRAY_API={{ xray_api }}
XRAY_LOCATION_ASSET={{ xray_asset_dir }}
INGRESS_DIRECT_GEOIP={{ ingress_direct_geoip | join(',') }}
INGRESS_DIRECT_GEOSITE={{ ingress_direct_geosite | join(',') }}
{% if ingress_name | length > 0 and ingress_host | length > 0 and reality_public_key | length > 0 and reality_short_id | length > 0 %}
# Public parameters for GET /v1/info (no secrets).
INGRESS_NAME={{ ingress_name }}
INGRESS_HOST={{ ingress_host }}
INGRESS_PORT={{ ingress_listen_port }}
INGRESS_SNI={{ reality_sni }}
INGRESS_PUBLIC_KEY={{ reality_public_key }}
INGRESS_SHORT_ID={{ reality_short_id }}
{% endif %}
