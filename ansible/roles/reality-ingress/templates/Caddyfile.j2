# {{ ansible_managed }}
{
	admin off
	http_port 80
	https_port 8443
	auto_https disable_redirects
	storage file_system {{ caddy_state_dir }}
	# Runtime/ACME errors go to the journal; no access log is configured. The
	# filter drops the logged request (its URI carries enrolment tokens).
	log default {
		output stderr
		level ERROR
		format filter {
			wrap console
			fields {
				request delete
			}
		}
	}
}

# Plain HTTP: only the ACME HTTP-01 challenge (answered by Caddy itself
# before these routes). Everything else is a bare 404.
:80 {
	respond 404
}

# Self-steal target of Reality ({{ reality_dest }}); loopback only.
{{ ingress_host }}:8443 {
	bind 127.0.0.1

	# Let's Encrypt via HTTP-01 on public :80 only (8443 is not reachable).
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	# The public enrolment paths (@enroll, @self) come from one shared file (#260), the same that
	# examples/compose/control imports. A release that adds a path changes only that file.
	import {{ caddy_config_dir }}/enroll-paths.caddy

{% if enroll_self_service | bool %}
	# Self-enrolment (#102): @self of enroll-paths.caddy.
	handle @self {
		reverse_proxy http://{{ enroll_upstream }} {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up Host {{ ingress_host }}
			transport http {
				dial_timeout 3s
				response_header_timeout 20s
				read_timeout 15s
				write_timeout 15s
			}
		}
	}
{% endif %}

	handle @enroll {
		reverse_proxy http://{{ enroll_upstream }} {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up Host {{ ingress_host }}
			transport http {
				dial_timeout 3s
				response_header_timeout 10s
				read_timeout 15s
				write_timeout 15s
			}
		}
	}

	handle {
		respond 404
	}
}
