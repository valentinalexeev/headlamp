# {{ ansible_managed }}
[Unit]
Description=Caddy self-steal front for the Reality ingress
After=network-online.target
Wants=network-online.target

[Service]
User={{ caddy_user }}
Environment=HOME={{ caddy_state_dir }}
Environment=XDG_CONFIG_HOME={{ caddy_state_dir }}
Environment=XDG_DATA_HOME={{ caddy_state_dir }}
ExecStart={{ caddy_bin }} run --config {{ caddy_config_dir }}/Caddyfile --adapter caddyfile
StateDirectory={{ caddy_state_dir | regex_replace('^/var/lib/', '') }}
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
