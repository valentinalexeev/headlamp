# {{ ansible_managed }}
[Unit]
Description=Xray (VLESS+Reality ingress)
After=network-online.target caddy-ingress.service ingress-guard.service
Wants=network-online.target caddy-ingress.service
# Fail closed: no xray without the nftables backstop.
Requires=ingress-guard.service

[Service]
User={{ xray_user }}
Environment=XRAY_LOCATION_ASSET={{ xray_asset_dir }}
ExecStart={{ xray_bin }} run -c {{ xray_config_dir }}/config.json
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
