# {{ ansible_managed }}
# The settings of tailguard (apps/tailguard/.env.example documents each one). No secret: the join key is never here.
TS_HOSTNAME={{ tailguard_hostname }}
TS_PORT={{ tailguard_ts_port }}
TS_LOGIN_SERVER={{ tailguard_login_server }}
{% if tailguard_login_key_file | default('') | length > 0 %}
# First login only: the path of the 0600 key file in run/ (mounted at /tmp). The role removes this line and the file.
TS_AUTHKEY=file:/tmp/{{ tailguard_login_key_file }}
{% endif %}
TG_CLIENT_MODE=1
EXIT_NODE_PREFIX={{ tailguard_exit_node_prefix }}
EXIT_NODE_TAG={{ tailguard_exit_node_tag }}
TG_LAN_ACCESS={{ tailguard_lan_access }}
TG_STATUS_PORT={{ tailguard_status_port }}
TG_BIND_ADDR={{ tailguard_bind_addr }}
{% if tailguard_nameservers | length > 0 %}
TG_NAMESERVERS={{ tailguard_nameservers }}
{% endif %}
{% if tailguard_block_derp_regions | length > 0 %}
BLOCK_DERP_REGIONS={{ tailguard_block_derp_regions }}
{% endif %}
