# {{ ansible_managed }}
[Unit]
Description=Guard: keep the task runner (user {{ task_runner_user }}) and its containers off loopback, LAN and the tailnet
After=network-pre.target
Wants=network-pre.target
Before=task-runner.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ task_runner_nft_bin }} -f {{ task_runner_guard_file }}
ExecReload={{ task_runner_nft_bin }} -f {{ task_runner_guard_file }}
# Stopping the guard stops the runner too (it Requires= this unit).
ExecStop={{ task_runner_nft_bin }} delete table inet task_runner_guard

[Install]
WantedBy=multi-user.target
