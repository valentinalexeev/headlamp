# {{ ansible_managed }}
# Read by systemd (EnvironmentFile); mode 0640 root:{{ task_runner_user }}. Holds the API token.
RUNNER_TOKEN={{ task_runner_token }}
RUNNER_LISTEN={{ task_runner_listen }}
RUNNER_STATE_DIR={{ task_runner_state_dir }}
RUNNER_CONTAINER_BIN=/usr/bin/podman
RUNNER_IMAGE={{ task_runner_image }}
RUNNER_MEMORY={{ task_runner_container_memory }}
RUNNER_PIDS_LIMIT={{ task_runner_pids_limit }}
