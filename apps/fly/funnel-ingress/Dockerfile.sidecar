# Build context: this directory (apps/fly/funnel-ingress). Build with:
#   docker build -f Dockerfile.sidecar -t funnel-sidecar .
#
# The sidecar is a second binary of the same module. It is stateless: its tailnet node is ephemeral and its
# scratch directory (FUNNEL_STATE_DIR, default /tmp/funnel-sidecar) can be an emptyDir.
#
# CI publishes it for linux/amd64 and linux/arm64. The Go build runs on the build platform and cross-compiles, so only
# the small final stage runs under emulation.
ARG TSVERSION=1.98.10

FROM --platform=$BUILDPLATFORM golang:1.26.5-alpine AS build
ARG TSVERSION
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN grep -q "tailscale.com v${TSVERSION}$" go.mod \
  || { echo "go.mod does not pin tailscale.com v${TSVERSION}" >&2; exit 1; }
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags "-s -w" -o /out/funnel-sidecar ./cmd/funnel-sidecar

FROM alpine:3.22
RUN apk add --no-cache ca-certificates \
  && adduser -D -u 10001 funnel
COPY --from=build /out/funnel-sidecar /usr/local/bin/funnel-sidecar
USER funnel
ENTRYPOINT ["/usr/local/bin/funnel-sidecar"]
