{
  "version": "example-1",
  "public_domain": "example.com",
  "namespaces": {
    "demo": {
      "ports": [
        { "lo": 8081, "hi": 8081 },
        { "lo": 9000, "hi": 9010 }
      ]
    }
  },
  "routes": [
    { "ns": "demo", "service": "docs", "target": "docs-host", "port": 8081 },
