{
  "title": "node-control",
  "subtitle": "on-demand control for my exit nodes",
  "nodes": {
    "vm-a": {
      "provider": "yandex",
      "tailnetName": "node-a",
      "yandex": { "instance_id": "<yandex-instance-id>" }
    },
    "vm-b": {
      "provider": "oci",
      "label": "OCI Compute",
      "tailnetName": "node-b",
      "oci": {
        "region": "<oci-region>",
        "compartment_id": "<oci-compartment-ocid>",
        "instance_name": "vm-b"
      }
    },
    "fly-c": {
      "provider": "fly",
      "tailnetName": "node-c",
      "fly": { "app": "<your-fly-exit-app>" }
    }
  }
}
