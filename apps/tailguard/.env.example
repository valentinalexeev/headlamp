# Copy to .env and fill in TS_AUTHKEY. .env is gitignored — never commit it.

# --- Tailscale side (default: Tailscale's own control plane) ---
# Reusable auth key from the Tailscale admin console (Settings > Keys).
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
TS_HOSTNAME=tg-node
TS_PORT=41642
# Empty = real Tailscale (default control server).
# For headscale: TS_LOGIN_SERVER=https://<your-headscale-url>
# TS_LOGIN_SERVER=

# --- TailGuard behaviour ---
# Client mode: no route advertising, an exit node is allowed.
TG_CLIENT_MODE=1
# Exit node: NOT pinned here. exit-node-tracker selects the online exit node whose
# name starts with this prefix, and re-selects it when it re-registers under a new
# IP or a suffixed name (my-exit-1). (A TS_EXIT_NODE here is ignored: compose blanks it,
# because a stale pin baked into the container would crashloop it after a reboot.)
EXIT_NODE_PREFIX=my-exit
# Read-only status page, auto-opened on wg0 + tailscale0. Blank to disable.
TG_WEBUI_PORT=8088
# TG_NAMESERVERS defaults to Cloudflare 1.1.1.1 if unset.

# DERP regions the tracker must never let tailscaled pick as its home relay (space-
# separated codes). Use when a region answers STUN (UDP) but its TCP/443 is blocked on
# your network: egress then dies with exit-node tx growing and rx 0. Leave empty
# unless you see that symptom.
# BLOCK_DERP_REGIONS=<region-code>
