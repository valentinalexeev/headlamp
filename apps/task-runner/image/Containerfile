# No default: a build without --build-arg BASE=<image>@sha256:... must fail.
ARG BASE
FROM ${BASE}
WORKDIR /app
RUN npm init -y >/dev/null && npm install --no-audit --no-fund playwright@1.64.1
ENV NODE_PATH=/app/node_modules
COPY host.js /app/host.js
# Browser session tools (noVNC mode): virtual display, window manager, VNC bridge.
RUN apt-get update \
 && apt-get install -y --no-install-recommends xvfb x11vnc novnc websockify openbox \
 && rm -rf /var/lib/apt/lists/*
# Google Chrome for browser sessions only (task runs keep Playwright's own Chromium). The installer downloads
# Google's package at build time (linux/amd64 only). The managed policy hides the "unsupported command-line flag"
# infobar that the required --no-sandbox would otherwise show.
RUN cd /app && npx playwright install chrome \
 && mkdir -p /etc/opt/chrome/policies/managed \
 && printf '{"CommandLineFlagSecurityWarningsEnabled": false}\n' > /etc/opt/chrome/policies/managed/session.json \
 && rm -rf /var/lib/apt/lists/*
COPY session.sh /app/session.sh
