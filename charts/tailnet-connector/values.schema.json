{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["controlURL", "connector", "image"],
  "properties": {
    "controlURL": {"type": "string", "pattern": "^https?://"},
    "connector": {
      "type": "object",
      "required": ["routes", "authKeySecret"],
      "properties": {
        "enabled": {"type": "boolean"},
        "hostname": {"type": "string"},
        "routes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}},
        "authKeySecret": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}}
        },
        "stateSecret": {"type": "string"},
        "extraArgs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {"repository": {"type": "string"}, "tag": {"type": "string"}, "digest": {"type": "string"}, "pullPolicy": {"type": "string"}}
    },
    "serve": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "url": {"type": "string"},
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "services"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
              "authKeySecret": {"type": "string"},
              "services": {"type": "string", "minLength": 1},
              "replicas": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
