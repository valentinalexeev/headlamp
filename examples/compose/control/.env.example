# Copy to .env (never commit .env). Pin every image by version AND digest:
#   docker buildx imagetools inspect ghcr.io/valentinalexeev/headlamp/headscale:<version>
HEADSCALE_IMAGE=ghcr.io/valentinalexeev/headlamp/headscale:0.10.0@sha256:<digest>
NODE_CONTROL_IMAGE=ghcr.io/valentinalexeev/headlamp/node-control:0.10.0@sha256:<digest>
FUNNEL_INGRESS_IMAGE=ghcr.io/valentinalexeev/headlamp/funnel-ingress:0.10.0@sha256:<digest>

# Public names. Point each at the load balancer (or the Elastic IP): see the module output public_address.
HEADSCALE_DOMAIN=headscale.example.com
ACME_EMAIL=admin@example.com
# Optional:
ENROLL_DOMAIN=
FUNNEL_DOMAIN=

# Where the data volume is mounted (terraform/modules/control-host/aws mounts it here).
DATA_DIR=/srv/headlamp/data

# Funnel wildcard certificates only (DNS-01). Empty: the plain Caddy image, no DNS plugin.
# See README.md, "The edge and its certificates". Credentials go in edge.env.
EDGE_DNS_PLUGINS=
FUNNEL_DNS=ondemand
