# TLS edge of the central host, for PUBLIC names only: headscale, the enrolment links and funnel. Let's Encrypt
# checks each name over the internet (HTTP-01 on port 80, or DNS-01 for wildcards). Tailnet-only serve names (#117)
# never come here: node-control signs their certificates with its own CA.
# The load balancer passes TCP through and keeps the client address, so TLS ends here and the peer is the client.
{
	email {$ACME_EMAIL}
	acme_ca {$CADDY_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	# Funnel (#127): Caddy gets a certificate for a funnel host at its first TLS connection, with HTTP-01. Before
	# that, it asks funnel-ingress, which says yes only for <service>.<namespace>.<FUNNEL_DOMAIN> with a live route.
	# No DNS credentials and no Caddyfile line per namespace are needed.
	on_demand_tls {
		ask http://funnel-ingress:8080/.well-known/headlamp/tls-ask
	}
}

# headscale: the control API, the noise protocol and DERP over HTTPS (all on one name).
{$HEADSCALE_DOMAIN} {
	reverse_proxy headscale:8080
}

# Optional, the public enrolment links of node-control (/e/<token>, /sub/<secret>). Remove the block if you do not
# use enrolment, or if a bridge serves the link host (see the node-control README, "Enrolment").
# ENROLL_TLS (set by compose): empty while ENROLL_DOMAIN is not set, so the snippet is "unused" and the .invalid name
# gets no ACME request (#216); "acme" for a real name.
{$ENROLL_DOMAIN:enroll.invalid} {
	import tls/{$ENROLL_TLS:unused}.caddy
	# /me and /oidc/*: self-enrolment with OIDC (#102). Remove them if you do not set OIDC_ISSUER.
	@public path /e/* /sub/* /me /me/* /oidc/login /oidc/callback
	handle @public {
		reverse_proxy node-control:8081
	}
	respond 404
}

# Optional, funnel-ingress: every host under FUNNEL_DOMAIN (for example admin.pdl.funnel.example.com). With the
# default FUNNEL_DNS=ondemand, each host gets its own certificate on demand (see the global block). To use one
# wildcard certificate per namespace instead, set FUNNEL_DNS to a DNS-01 provider file in dns/ (route53, cloudflare,
# googleclouddns, rfc2136).
# While FUNNEL_DOMAIN is not set, compose leaves FUNNEL_DNS empty, so the snippet is "unused": no ACME and no
# on-demand TLS for funnel.invalid (#216).
*.*.{$FUNNEL_DOMAIN:funnel.invalid} {
	import dns/{$FUNNEL_DNS:unused}.caddy
	reverse_proxy funnel-ingress:8080
}
