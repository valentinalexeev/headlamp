# The edge keeps *.<FUNNEL_DOMAIN> on its public address, with Cloudflare (#384). Build with
# EDGE_DNS_PLUGINS="github.com/caddy-dns/cloudflare@<version> github.com/mholt/caddy-dynamicdns@<commit>".
# Credentials: CLOUDFLARE_API_TOKEN in edge.env, the same token as DNS-01. The record is not proxied.
dynamic_dns {
	provider cloudflare {env.CLOUDFLARE_API_TOKEN}
	domains {
		{$FUNNEL_DOMAIN} *
	}
	ip_source simple_http {$FUNNEL_DDNS_IP_URL:https://api.ipify.org}
	versions ipv4
	check_interval {$FUNNEL_DDNS_INTERVAL:5m}
	ttl 5m
}
