# The edge keeps *.<FUNNEL_DOMAIN> on its public address, with Google Cloud DNS (#384). Build with
# EDGE_DNS_PLUGINS="github.com/caddy-dns/googleclouddns@<version> github.com/mholt/caddy-dynamicdns@<commit>".
# Credentials: the same as DNS-01 (GCP_PROJECT; on a GCE VM its service account, with roles/dns.admin on the one zone).
dynamic_dns {
	provider googleclouddns {
		gcp_project {env.GCP_PROJECT}
	}
	domains {
		{$FUNNEL_DOMAIN} *
	}
	ip_source simple_http {$FUNNEL_DDNS_IP_URL:https://api.ipify.org}
	versions ipv4
	check_interval {$FUNNEL_DDNS_INTERVAL:5m}
	ttl 5m
}
