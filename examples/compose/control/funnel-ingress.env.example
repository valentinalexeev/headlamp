# Copy to funnel-ingress.env (never commit it). Full list: apps/funnel-ingress/README.md.
# Put each secret value in single quotes, for example KEY='value'. Compose expands $ in a value without them (#302).
TS_AUTHKEY=<pre-auth key with tag:funnel-ingress>
FUNNEL_CONFIG_URL=http://<tailnet IP of node-control>
