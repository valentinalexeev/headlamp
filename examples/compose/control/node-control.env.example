# Copy to node-control.env (never commit it). Full list: apps/node-control/README.md.
# Put each secret value in single quotes, for example KEY='value'. Compose expands $ in a value without them (#302).
TAILSCALE_AUTH_KEY=<pre-auth key with tag:node-control>
HEADSCALE_API_KEY=<headscale apikeys create>
ADMIN_USERS=<your login>
# NODES_CONFIG=/srv/app/nodes.json
# ENROLL_DB=/var/lib/tailscale/enroll.db
# ENROLL_CONFIG=/srv/app/enroll.json
# ENROLL_SECRET_KEY=<openssl rand -base64 32>
# POLICY_DB=/var/lib/tailscale/policy.db
# ENROLL_ALLOWED_HOSTS=node-control
# Self-enrolment with OIDC (#102): people sign in at https://<link_host>/me.
# OIDC_ISSUER=<issuer URL>
# OIDC_CLIENT_ID=<client id>
# OIDC_CLIENT_SECRET=<client secret>
# OIDC_REDIRECT_URL=https://<link_host>/oidc/callback
# OIDC_DB=/var/lib/tailscale/oidc.db
# OIDC_ALLOWED_GROUPS=<group that may enrol>
# Funnel (#127): node-control keeps the one public record *.<FUNNEL_PUBLIC_DOMAIN> -> FUNNEL_INGRESS_HOSTNAME.
# FUNNEL_PUBLIC_DOMAIN=<funnel domain>
# FUNNEL_INGRESS_HOSTNAME=<edge address or name>
# FUNNEL_DNS_PROVIDER=route53            # or cloudflare; unset: the console shows a manual checklist
# FUNNEL_DNS_ZONE=<hosted zone id>
# FUNNEL_DNS_CLOUDFLARE_TOKEN=<token with DNS edit on that one zone>
# Tailnet DNS (#286): node-control resolves the tailnet names for bridges, and writes its records into the file that
# headscale reads (dns.extra_records_path), so every tailnet device gets them. See "Tailnet DNS (optional)" in the README.
# TAILNET_DNS_DB=/var/lib/tailscale/dns.db
# TAILNET_DNS_EXTRA_RECORDS_FILE=/dns/extra-records.json
# AWS exit nodes (provider "aws"): the region. On an EC2 control host the host's own region (from IMDSv2) is the
# default, so this is needed only off EC2 or for nodes in another region. The instance role needs IMDS hop limit 2
# (control-host/aws metadata_hop_limit, #204), because node-control runs on the bridge network.
# AWS_REGION=<region>
