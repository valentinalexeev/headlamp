# Copy to node-control.env (never commit it). Full list: apps/node-control/README.md.
TAILSCALE_AUTH_KEY=<pre-auth key with tag:node-control>
HEADSCALE_API_KEY=<headscale apikeys create>
ADMIN_USERS=<your login>
# NODES_CONFIG=/srv/app/nodes.json
# ENROLL_DB=/var/lib/tailscale/enroll.db
# ENROLL_CONFIG=/srv/app/enroll.json
# ENROLL_SECRET_KEY=<openssl rand -base64 32>
# POLICY_DB=/var/lib/tailscale/policy.db
# ENROLL_ALLOWED_HOSTS=node-control
