# Example root stack: instantiate the vendored modules. Rename to main.tf and adapt.
# Module inputs are documented in vendor/headlamp/terraform/modules/exit-node-vm/<provider>/variables.tf.
module "node1" {
  source = "../vendor/headlamp/terraform/modules/exit-node-vm/oci"

  name                   = "node1"                 # also the node's tailscale hostname
  compartment_id         = var.oci_compartment_id
  shape                  = "VM.Standard.E2.1.Micro"
  ocpus                  = 1
  memory_in_gbs          = 1
  ssh_public_key         = var.ssh_public_key
  headscale_login_server = var.headscale_login_server
  tailscale_authkey      = var.node1_tailscale_authkey
}

