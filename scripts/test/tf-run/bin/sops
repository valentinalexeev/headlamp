#!/usr/bin/env python3
import sys, json, base64, os
a = sys.argv[1:]
if a and a[0] == "-d":
    d = json.load(open(a[1]))
    raw = base64.b64decode(d["data"]).decode()
    try:   # real sops re-serialises JSON (different indentation) -- mimic it
        raw = json.dumps(json.loads(raw), indent=4) + "\n"
    except ValueError:
        pass
    sys.stdout.write(raw); sys.exit(0)
if a and a[0] == "-e":
    if os.environ.get("STUB_SOPS_FAIL_ENC"): sys.stderr.write("stub: encrypt failed\n"); sys.exit(1)
    f = a[-1]; raw = open(f, "rb").read()
    json.dump({"data": base64.b64encode(raw).decode(), "sops": {"age": a[a.index("--age")+1]}}, open(f, "w")); sys.exit(0)
sys.exit(2)
